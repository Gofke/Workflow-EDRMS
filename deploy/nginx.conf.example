# JusPol EDRMS — nginx in front of the application, with TLS.
#
#   https://edrms.juspol.sr/          the web application (built frontend)
#   https://edrms.juspol.sr/api/      the API (Node, port 3000, local only)
#
# The backend runs with NODE_ENV=production and TRUST_PROXY=1, so the session
# cookie is marked Secure and is only sent over HTTPS.
server {
    listen 80;
    server_name edrms.juspol.sr;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name edrms.juspol.sr;

    ssl_certificate     /etc/ssl/juspol/fullchain.pem;
    ssl_certificate_key /etc/ssl/juspol/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;

    # Security headers. nginx drops these in any location that sets its own
    # add_header, so the two locations below include them again.
    include /etc/nginx/snippets/juspol-security-headers.conf;

    client_max_body_size 45m;

    # The stock mime.types lacks two types the app needs: .mjs (the PDF viewer's
    # worker, refused by browsers when served as text/plain) and the manifest.
    include /etc/nginx/mime.types;
    types { application/javascript mjs; application/manifest+json webmanifest; }

    root /opt/juspol/frontend/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
        # The API sets its own security headers (helmet). Setting a header here
        # stops nginx adding the server-level ones a second time.
        add_header Cache-Control "no-store" always;
    }

    # The service worker must not be cached, so updates reach every device.
    location = /sw.js {
        include /etc/nginx/snippets/juspol-security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location /assets/ {
        include /etc/nginx/snippets/juspol-security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location / { try_files $uri /index.html; }
}

# --- /etc/nginx/snippets/juspol-security-headers.conf -------------------------
# (a separate file; shown here so the whole setup is in one place)
#
# add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
# add_header X-Content-Type-Options nosniff always;
# add_header Referrer-Policy same-origin always;
# add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
# add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
