# JusPol EDRMS - backend environment
# Copy to .env and fill in real values before starting the server.

NODE_ENV=development
PORT=3000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=juspol
DB_PASSWORD=change_me
DB_DATABASE=juspol_edrms

# Session signing secret. Must be a long random string. Never reuse across environments.
SESSION_SECRET=change_me_to_a_long_random_string
# Session idle lifetime in minutes
SESSION_IDLE_MINUTES=30

# Browser origin allowed to call this API (the frontend URL)
CORS_ORIGIN=http://localhost:5173

# Password used for every seeded pilot account. Test environments only.
SEED_PASSWORD=choose_a_test_password

# --- Open decisions, parameterised. Not policy values. ---
# DEC-01 registration numbering scheme. OPEN. The default below is a neutral
# placeholder so the PoC can run; it is not a proposed Ministry scheme.
REGISTRATION_IDENTITY_PATTERN={DIRECTION}-{YEAR}-{SEQ}
REGISTRATION_SEQUENCE_PADDING=5
REGISTRATION_MARKER_INCOMING=IN
REGISTRATION_MARKER_OUTGOING=UIT
REGISTRATION_MARKER_INTERNAL=INT
# DEC-08 minimum mandatory metadata set. OPEN. Comma-separated field names.
REGISTRATION_MANDATORY_FIELDS=subject
# DEC-11 dossier identity scheme. OPEN. Placeholder default, not a proposal.
DOSSIER_IDENTITY_PATTERN=DOS-{YEAR}-{SEQ}
DOSSIER_SEQUENCE_PADDING=4
# DEC-12 which due-date changes require a reason. OPEN.
# always | change | never. Placeholder default, not a recommendation.
DUE_DATE_REASON_REQUIRED_ON=change

# --- Document capture (V0.1.7) ---
# Where captured document bytes are stored. Content-addressed; back this up.
DOCUMENT_STORAGE_PATH=./captured-documents
DOCUMENT_MAX_BYTES=20971520
# Accepted media types. Operational setting, not a baseline decision.
DOCUMENT_ALLOWED_TYPES=application/pdf,image/jpeg,image/png,image/tiff,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# --- DEC-13 delegation capability matrix. OPEN. Narrow placeholder defaults. ---
DELEGATION_GRANTING_ROLES=MINISTER,DIRECTEUR,ONDER_DIRECTEUR
DELEGATABLE_ACTIONS=ASSIGN_RESPONSIBILITY,SET_DUE_DATE
DELEGATION_MAX_DURATION_DAYS=90

# --- OCR. FR-COR-015 is conditional; off by default. The engine named in
# OCR_COMMAND must be installed on the server when this is true. Read text is
# retrieval assistance and never replaces captured content. ---
OCR_ENABLED=false
OCR_COMMAND=tesseract
OCR_LANGUAGES=eng
OCR_TIMEOUT_MS=30000
OCR_MEDIA_TYPES=image/jpeg,image/png,image/tiff
OCR_MAX_CHARACTERS=200000
# PDFs are read with a text-layer reader rather than OCR, under the same
# switch. A scanned-only PDF carries no text layer and reads as empty.
PDF_TEXT_COMMAND=pdftotext
PDF_TEXT_MEDIA_TYPES=application/pdf

# --- Dossier close/reopen authority. OPEN decision. Narrow placeholder. ---
DOSSIER_CLOSURE_ROLES=MINISTER,DIRECTEUR,ONDER_DIRECTEUR

# --- Workflow. DEC-15 (Reject) is OPEN, so Reject is not built at all. ---
# Whether approval authority may be delegated. Default off, deliberately.
WORKFLOW_APPROVAL_DELEGATION=false

# =====================================================================
# Phase 3 (V0.3.0)
# =====================================================================

# --- Addresses ---
# The address people use to reach the system. Printed on receipts, seals and
# QR codes, and used in e-mail links. Use the real https address in production.
PUBLIC_BASE_URL=https://edrms.juspol.local
# Behind nginx (deploy/nginx.conf.example) set to 1 so the real client address is logged.
TRUST_PROXY=1

# --- Keys. Created on first start if absent: the Ed25519 sealing key and the
# web-push (VAPID) keys. Back this folder up together with the database;
# without it existing seals can still be checked but no new ones made. ---
KEYS_DIR=./keys
# Encrypts the two-step-verification secrets at rest. Long random string; if
# unset the SESSION_SECRET is used. Changing it later disables existing MFA.
MFA_ENCRYPTION_KEY=change_me_to_another_long_random_string

# --- Background work: reminders, escalations, digests and the nightly
# integrity check (between 02:00 and 05:00 Suriname time). ---
SCHEDULER_ENABLED=true
INTEGRITY_SCHEDULE=on

# --- OCR for scanned PDFs (pages are rendered with pdftoppm and read with tesseract).
# For Dutch and English: OCR_LANGUAGES=nld+eng and install tesseract-ocr-nld.
OCR_PDF_PAGES=true
OCR_PDF_MAX_PAGES=10
PDF_RENDER_COMMAND=pdftoppm

# --- Virus scanning of every uploaded file (ClamAV). In production set
# VIRUS_SCAN_COMMAND=clamdscan; empty switches scanning off. With
# fail-open=false a file is refused when the scanner does not answer.
VIRUS_SCAN_COMMAND=
VIRUS_SCAN_ARGS=--no-summary
VIRUS_SCAN_FAIL_OPEN=false
VIRUS_SCAN_TIMEOUT_MS=60000

# --- E-mail. Without SMTP_HOST every message is kept in the outbox as LOGGED
# (visible under Beheer → Berichten), so nothing is lost and nothing leaves. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="JusPol EDRMS <edrms@juspol.local>"
SMTP_TLS_INSECURE=false

# --- SMS. Any gateway that accepts a JSON POST (e.g. a Telesur or Digicel
# business API), or Twilio. Without a provider SMS are only logged. ---
SMS_PROVIDER=
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Push notifications to phones and desktops (installed app). Keys are
# generated into KEYS_DIR when these are empty. ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ict@juspol.local
PUSH_EXTRA_CA_FILE=

# --- The assistant ("Vraag de assistent"). Without a language model the
# built-in engine answers: free, offline, nothing leaves the server.
# Provider and model are chosen under Beheer → Assistent; values set here win
# and are shown there as fixed. The key lives ONLY here — never in git, the
# database, a document or a chat. For the free Gemini tier:
#   AI_PROVIDER=gemini  AI_MODEL=gemini-flash-latest
#   AI_FALLBACK_MODELS=gemini-flash-lite-latest  AI_API_KEY=<key from Google AI Studio>
# Free tier: Google may use what is sent to improve its products, so the
# assistant sends metadata only (numbers, statuses, dates, unit and staff
# names) — never subjects, document text or confidential records. ---
APP_ENV=development
AI_PROVIDER=
AI_MODEL=
AI_FALLBACK_MODELS=
AI_API_KEY=
AI_BASE_URL=
# free | paid — a paid model never falls back to a free one
AI_TIER=free
AI_MAX_OUTPUT_TOKENS=1024
# Per model call / per question (milliseconds)
AI_CALL_TIMEOUT_MS=30000
AI_TOTAL_TIMEOUT_MS=80000
# Questions per person per hour (empty: the setting, default 30)
AI_HOURLY_LIMIT=
AI_IP_LIMIT_PER_MINUTE=60
# Origins allowed to call /api/v1/ai (comma list; default CORS_ORIGIN)
ALLOWED_ORIGINS=
# Older text features with a local model (Ollama) — seconds can be slow there
AI_TIMEOUT_MS=90000

# --- Links with other systems ---
# This ministry's code in signed exchange packages with other ministries.
EXCHANGE_ORG_CODE=JUSPOL
# Largest WijSamen report and largest e-mail taken in through the mail gateway.
WIJSAMEN_MAX_BYTES=40mb
INTAKE_MAX_BYTES=30mb

# --- Backups (deploy/backup.sh). When set, backups are encrypted with AES-256.
# Keep the passphrase somewhere other than the backup itself. ---
BACKUP_PASSPHRASE=
