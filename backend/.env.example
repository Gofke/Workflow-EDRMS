# JusPol EDRMS - backend environment
# Copy to .env and fill in real values before starting the server.

NODE_ENV=development
PORT=3000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=juspol
DB_PASSWORD=change_me
DB_DATABASE=juspol_edrms

# Session signing secret. Must be a long random string. Never reuse across environments.
SESSION_SECRET=change_me_to_a_long_random_string
# Session idle lifetime in minutes
SESSION_IDLE_MINUTES=30

# Browser origin allowed to call this API (the frontend URL)
CORS_ORIGIN=http://localhost:5173

# Password used for every seeded pilot account. Test environments only.
SEED_PASSWORD=JusPol!Test2026

# --- Open decisions, parameterised. Not policy values. ---
# DEC-01 registration numbering scheme. OPEN. The default below is a neutral
# placeholder so the PoC can run; it is not a proposed Ministry scheme.
REGISTRATION_IDENTITY_PATTERN={DIRECTION}-{YEAR}-{SEQ}
REGISTRATION_SEQUENCE_PADDING=5
REGISTRATION_MARKER_INCOMING=IN
REGISTRATION_MARKER_OUTGOING=UIT
REGISTRATION_MARKER_INTERNAL=INT
# DEC-08 minimum mandatory metadata set. OPEN. Comma-separated field names.
REGISTRATION_MANDATORY_FIELDS=subject
# DEC-11 dossier identity scheme. OPEN. Placeholder default, not a proposal.
DOSSIER_IDENTITY_PATTERN=DOS-{YEAR}-{SEQ}
DOSSIER_SEQUENCE_PADDING=4
# DEC-12 which due-date changes require a reason. OPEN.
# always | change | never. Placeholder default, not a recommendation.
DUE_DATE_REASON_REQUIRED_ON=change

# --- Document capture (V0.1.7) ---
# Where captured document bytes are stored. Content-addressed; back this up.
DOCUMENT_STORAGE_PATH=./captured-documents
DOCUMENT_MAX_BYTES=20971520
# Accepted media types. Operational setting, not a baseline decision.
DOCUMENT_ALLOWED_TYPES=application/pdf,image/jpeg,image/png,image/tiff,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# --- DEC-13 delegation capability matrix. OPEN. Narrow placeholder defaults. ---
DELEGATION_GRANTING_ROLES=MINISTER,DIRECTEUR,ONDER_DIRECTEUR
DELEGATABLE_ACTIONS=ASSIGN_RESPONSIBILITY,SET_DUE_DATE
DELEGATION_MAX_DURATION_DAYS=90

# --- OCR. FR-COR-015 is conditional; off by default. The engine named in
# OCR_COMMAND must be installed on the server when this is true. Read text is
# retrieval assistance and never replaces captured content. ---
OCR_ENABLED=false
OCR_COMMAND=tesseract
OCR_LANGUAGES=eng
OCR_TIMEOUT_MS=30000
OCR_MEDIA_TYPES=image/jpeg,image/png,image/tiff
OCR_MAX_CHARACTERS=200000
# PDFs are read with a text-layer reader rather than OCR, under the same
# switch. A scanned-only PDF carries no text layer and reads as empty.
PDF_TEXT_COMMAND=pdftotext
PDF_TEXT_MEDIA_TYPES=application/pdf

# --- Dossier close/reopen authority. OPEN decision. Narrow placeholder. ---
DOSSIER_CLOSURE_ROLES=MINISTER,DIRECTEUR,ONDER_DIRECTEUR

# --- Workflow. DEC-15 (Reject) is OPEN, so Reject is not built at all. ---
# Whether approval authority may be delegated. Default off, deliberately.
WORKFLOW_APPROVAL_DELEGATION=false
